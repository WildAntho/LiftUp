# container dans lequel l'appli est build
FROM node:24-alpine AS builder

RUN mkdir /app
WORKDIR /app

COPY package*.json ./
COPY tsconfig*.json ./
RUN npm i
COPY src src
RUN npm run build

# container dans lequel l'appli sera lancée une fois build
FROM node:24-alpine
WORKDIR /app
COPY --from=builder /app/build ./build
COPY package*.json ./
RUN npm i --production
CMD ["sh", "-c", "npm run migration:run && npm run start"]